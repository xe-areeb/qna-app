# ---------------------------------------------------------------------------
# Local development (.env.local)
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in values from `npx convex dev`.
# Cloudflare deployments use the same variable names, but they're configured
# in the Cloudflare Pages dashboard (or `wrangler.toml`) instead of in a
# committed file. See README.md → "Deployment".

# ---------------------------------------------------------------------------
# Next.js (browser + build) - must be set in `.env.local` AND in Cloudflare
# Pages env vars for both Production and Preview environments.
# ---------------------------------------------------------------------------

# Convex deployment URL (browser + server). Required for live queries.
# Without it, the app uses a build-time placeholder and skips Convex live
# queries (a yellow banner appears in the UI).
NEXT_PUBLIC_CONVEX_URL=

# Temporary demo privacy gate (browser + build). Add this in Cloudflare Pages
# for both Production and Preview:
#   NEXT_PUBLIC_DEMO_ACCESS_CODE=your-demo-code
#
# This is only light demo privacy for internal testing. Because it is prefixed
# with NEXT_PUBLIC_, the value is included in the static frontend bundle and is
# not production-grade security.
NEXT_PUBLIC_DEMO_ACCESS_CODE=

# ---------------------------------------------------------------------------
# Convex CLI (local only - Cloudflare doesn't need this)
# ---------------------------------------------------------------------------
# Written automatically by `npx convex dev` when it links your local checkout
# to a Convex deployment. Don't commit real values.
# CONVEX_DEPLOYMENT=

# ---------------------------------------------------------------------------
# Admin gate (MVP) - server-side, NOT a Next.js / Cloudflare env var
# ---------------------------------------------------------------------------
# `ADMIN_ACCESS_CODE` is read by Convex functions via
# `process.env.ADMIN_ACCESS_CODE`. It lives on the **Convex deployment**, not
# in `.env.local` and not in Cloudflare Pages.
#
# Set it once per Convex deployment (dev, preview, prod):
#
#   npx convex env set ADMIN_ACCESS_CODE <your-code>
#
# Do NOT prefix with `NEXT_PUBLIC_` - the value must stay server-side. The
# frontend never reads this variable directly; it only ever holds the value
# the visitor types into `/admin`, cached per-tab in `sessionStorage`.
#
# See README.md → "Admin gate (MVP)" and `admin-gate-flow.md` for details.
